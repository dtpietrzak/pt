{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pt.davidp.dev/schemas/exercises.schema.json",
  "title": "exercises",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "exercises": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Exercise"
      }
    }
  },
  "required": [
    "schema_version",
    "exercises"
  ],
  "$defs": {
    "Exercise": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EX_[A-Z0-9_]+$"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "enum": [
            "breath",
            "mobility",
            "core",
            "hip",
            "squat",
            "hinge",
            "lunge",
            "push",
            "pull",
            "carry",
            "walk",
            "impact",
            "speed",
            "sport",
            "relief",
            "stretch"
          ]
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "stop_if": {
          "type": "string"
        },
        "regressions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "progressions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contraindications": {
          "type": "string"
        },
        "in_default_program": {
          "type": "boolean"
        },
        "verdict": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "equipment",
        "cues",
        "stop_if",
        "regressions",
        "progressions",
        "contraindications",
        "in_default_program"
      ]
    }
  }
}
