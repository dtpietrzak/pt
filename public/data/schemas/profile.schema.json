{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pt.davidp.dev/schemas/profile.schema.json",
  "title": "profile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "timezone": {
      "const": "America/Chicago"
    },
    "body_weight_lb": {
      "type": "number",
      "default": 180,
      "description": "Default 180. Displayed load = load_bw * body_weight_lb, snapped to 5 lb unless equipment lists specific sizes."
    },
    "sports": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sports the return-to-sport levels are programmed for. Default: soccer, football."
    },
    "equipment": {
      "type": "object",
      "properties": {
        "bands": {
          "type": "boolean",
          "default": true
        },
        "dumbbells_lb": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "kettlebells_lb": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "barbell": {
          "type": "boolean",
          "default": true
        },
        "plates_lb": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "rack_with_safeties": {
          "type": "boolean",
          "default": true
        },
        "bench": {
          "type": "boolean",
          "default": true
        },
        "pull_up_bar": {
          "type": "boolean",
          "default": true
        },
        "step_box_in": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "blocks": {
          "type": "boolean",
          "default": true
        },
        "cones": {
          "type": "boolean",
          "default": true
        },
        "track_or_field": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "baselines": {
      "type": "object",
      "properties": {
        "pain_rest": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "stiffness_min": {
          "type": "number"
        },
        "standing_h": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "clinician_contact": {
      "type": "string",
      "description": "Treating physician name/phone shown on red-flag screens. Empty by default."
    },
    "notify": {
      "type": "object",
      "properties": {
        "morning": {
          "type": "string",
          "description": "Default 08:00 America/Chicago"
        },
        "evening": {
          "type": "string",
          "description": "Default 15:30 America/Chicago"
        },
        "night": {
          "type": "string",
          "description": "Default 21:00 America/Chicago"
        },
        "post_workout": {
          "type": "string",
          "description": "Default on_session_complete: prompted when a session is completed, not on a schedule"
        }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "max_item_changes_per_finalized_session": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "default": 3
        },
        "layoff_rule_enabled": {
          "type": "boolean",
          "default": true
        },
        "clean_exposures_required": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "default": 2,
          "description": "Clean exposures needed to advance one rung; default 2."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "timezone",
    "baselines"
  ]
}
