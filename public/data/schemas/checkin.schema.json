{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pt.davidp.dev/schemas/checkin.schema.json",
  "title": "checkin",
  "$ref": "#/$defs/CheckIn",
  "$defs": {
    "CheckIn": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "morning"
            },
            "id": {
              "type": "string"
            },
            "ts": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 with offset, America/Chicago"
            },
            "local_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "session_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "red_flags": {
              "$ref": "#/$defs/RedFlags"
            },
            "anything_new_or_scary": {
              "type": "boolean"
            },
            "oddities": {
              "type": "string"
            },
            "oddity_tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "data": {
              "type": "object",
              "properties": {
                "wake_time": {
                  "type": "string",
                  "pattern": "^\\d{2}:\\d{2}$"
                },
                "protection_window_respected": {
                  "type": "boolean"
                },
                "pain_on_waking": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                },
                "stiffness_min": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "stiffness_still_present": {
                  "type": "boolean"
                },
                "sleep_hours": {
                  "type": "number"
                },
                "sleep_quality": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "woke_from_pain_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "hip_shift": {
                  "type": "boolean"
                },
                "symptoms": {
                  "$ref": "#/$defs/Symptoms"
                }
              },
              "additionalProperties": false,
              "required": [
                "pain_on_waking",
                "symptoms"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "ts",
            "local_date",
            "data",
            "red_flags"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "post_workout"
            },
            "id": {
              "type": "string"
            },
            "ts": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 with offset, America/Chicago"
            },
            "local_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "session_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "red_flags": {
              "$ref": "#/$defs/RedFlags"
            },
            "anything_new_or_scary": {
              "type": "boolean"
            },
            "oddities": {
              "type": "string"
            },
            "oddity_tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "data": {
              "type": "object",
              "properties": {
                "completed_items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "item_key": {
                        "type": "string"
                      },
                      "rung_done": {
                        "type": "integer"
                      },
                      "completed": {
                        "type": "boolean"
                      },
                      "pain_peak": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 10
                      },
                      "sharp_electrical": {
                        "type": "boolean"
                      },
                      "form_breakdown": {
                        "type": "boolean"
                      },
                      "skipped_reason": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "item_key",
                      "completed"
                    ]
                  }
                },
                "pain_peak": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                },
                "pain_15min_after": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                },
                "rpe": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                },
                "settle_bucket": {
                  "enum": [
                    "lt_30",
                    "30_120",
                    "gt_120",
                    "not_yet"
                  ]
                },
                "form_breakdown": {
                  "type": "boolean"
                },
                "symptoms": {
                  "$ref": "#/$defs/Symptoms"
                }
              },
              "additionalProperties": false,
              "required": [
                "pain_peak",
                "symptoms",
                "completed_items"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "ts",
            "local_date",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "evening"
            },
            "id": {
              "type": "string"
            },
            "ts": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 with offset, America/Chicago"
            },
            "local_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "session_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "red_flags": {
              "$ref": "#/$defs/RedFlags"
            },
            "anything_new_or_scary": {
              "type": "boolean"
            },
            "oddities": {
              "type": "string"
            },
            "oddity_tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "data": {
              "type": "object",
              "properties": {
                "standing": {
                  "type": "object",
                  "properties": {
                    "first_pressure_h": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "censored": {
                      "type": "boolean",
                      "description": "true if breaks were taken before pressure appeared"
                    },
                    "upright_h_total": {
                      "type": "number"
                    },
                    "breaks_taken": {
                      "type": "integer"
                    },
                    "decomp_breaks_done": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": false
                },
                "sitting": {
                  "type": "object",
                  "properties": {
                    "first_pressure_min": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Minutes of sitting when local pressure first reached 3/10"
                    },
                    "censored": {
                      "type": "boolean",
                      "description": "true if the sit block ended or was switched before pressure appeared"
                    },
                    "seated_min_total": {
                      "type": "number"
                    },
                    "flared": {
                      "type": "boolean",
                      "description": "true if sitting flared symptoms today"
                    },
                    "prescribed_block_min": {
                      "type": "number"
                    },
                    "completed_blocks": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": false
                },
                "posture_cycle": {
                  "type": "object",
                  "properties": {
                    "work_mode_used": {
                      "type": "boolean"
                    },
                    "cycles_completed": {
                      "type": "integer"
                    },
                    "stand_prescribed_min": {
                      "type": "number"
                    },
                    "sit_prescribed_min": {
                      "type": "number"
                    },
                    "decomp_done": {
                      "type": "integer"
                    },
                    "early_switches": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "phase": {
                            "enum": [
                              "stand",
                              "walk",
                              "sit",
                              "decompress"
                            ]
                          },
                          "prescribed_min": {
                            "type": "number"
                          },
                          "actual_min": {
                            "type": "number"
                          },
                          "reason": {
                            "enum": [
                              "sore_early",
                              "manual"
                            ]
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "phase",
                          "actual_min"
                        ]
                      }
                    },
                    "actual_blocks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "phase": {
                            "enum": [
                              "stand",
                              "walk",
                              "sit",
                              "decompress"
                            ]
                          },
                          "prescribed_min": {
                            "type": "number"
                          },
                          "actual_min": {
                            "type": "number"
                          },
                          "started_at": {
                            "type": "string"
                          },
                          "ended_at": {
                            "type": "string"
                          },
                          "ended_how": {
                            "enum": [
                              "alarm",
                              "sore_early",
                              "manual",
                              "snooze_then_switch",
                              "work_end"
                            ]
                          },
                          "snoozes": {
                            "type": "integer"
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "phase",
                          "actual_min"
                        ]
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "walk_min": {
                  "type": "number"
                },
                "pain_peak_today": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                },
                "forced_rest_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "activity_limited": {
                  "type": "boolean"
                },
                "hip_shift": {
                  "type": "boolean"
                },
                "session_symptoms_settled": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "symptoms": {
                  "$ref": "#/$defs/Symptoms"
                }
              },
              "additionalProperties": false,
              "required": [
                "pain_peak_today",
                "symptoms"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "ts",
            "local_date",
            "data"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "night"
            },
            "id": {
              "type": "string"
            },
            "ts": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 with offset, America/Chicago"
            },
            "local_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "session_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "red_flags": {
              "$ref": "#/$defs/RedFlags"
            },
            "anything_new_or_scary": {
              "type": "boolean"
            },
            "oddities": {
              "type": "string"
            },
            "oddity_tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "data": {
              "type": "object",
              "properties": {
                "bedtime_pain": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                },
                "symptoms": {
                  "$ref": "#/$defs/Symptoms"
                },
                "ready_for_tomorrow": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "required": [
                "bedtime_pain",
                "symptoms"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "ts",
            "local_date",
            "data",
            "red_flags"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "weekly"
            },
            "id": {
              "type": "string"
            },
            "ts": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 with offset, America/Chicago"
            },
            "local_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "session_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "red_flags": {
              "$ref": "#/$defs/RedFlags"
            },
            "anything_new_or_scary": {
              "type": "boolean"
            },
            "oddities": {
              "type": "string"
            },
            "oddity_tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "data": {
              "type": "object",
              "properties": {
                "body_weight_lb": {
                  "type": "number"
                },
                "overall_confidence": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "goals_notes": {
                  "type": "string"
                },
                "equipment_changes": {
                  "type": "string"
                },
                "plan_feedback": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "id",
            "ts",
            "local_date",
            "data"
          ]
        }
      ]
    },
    "Symptoms": {
      "type": "object",
      "properties": {
        "pain_now": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "sharp_electrical": {
          "type": "boolean"
        },
        "sharp_context": {
          "enum": [
            "exercise",
            "accidental_bend_twist",
            "ordinary_movement",
            "at_rest"
          ]
        },
        "sharp_settle_min": {
          "type": "number"
        },
        "leg_symptoms": {
          "enum": [
            "none",
            "buttock",
            "thigh",
            "below_knee",
            "foot"
          ]
        },
        "leg_trend": {
          "enum": [
            "centralizing",
            "same",
            "peripheralizing"
          ]
        },
        "numbness_tingling": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "pain_now",
        "sharp_electrical",
        "leg_symptoms",
        "numbness_tingling"
      ]
    },
    "RedFlags": {
      "type": "object",
      "properties": {
        "saddle_numbness": {
          "type": "boolean"
        },
        "bladder_bowel_change": {
          "type": "boolean"
        },
        "new_leg_weakness": {
          "type": "boolean"
        },
        "new_numbness_tingling": {
          "type": "boolean"
        },
        "fever_with_back_pain": {
          "type": "boolean"
        },
        "night_pain_unrelieved": {
          "type": "boolean"
        },
        "bilateral_leg_symptoms": {
          "type": "boolean"
        },
        "trauma_since_last_checkin": {
          "type": "boolean"
        },
        "unexplained_weight_loss": {
          "type": "boolean"
        },
        "new_swelling_in_back": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
