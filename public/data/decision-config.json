{
  "config_version": "1.0.0",
  "protected": true,
  "note": "Safety thresholds. Agent patches must not edit this file; only David may change it in the app settings.",
  "severity_order": [
    "green",
    "yellow",
    "orange",
    "red"
  ],
  "defaults": {
    "pain_rest_baseline": 1,
    "stiffness_baseline_min": 30,
    "standing_baseline_h": 5,
    "sitting_baseline_min": 20
  },
  "pain": {
    "green_max": 2,
    "yellow_max": 4,
    "orange_min": 5
  },
  "stiffness": {
    "green_slack_min": 5,
    "yellow_mult": 1.5,
    "yellow_add_min": 15,
    "rule": "green_limit=B+5; yellow_limit=max(1.5*B, B+15); above yellow_limit is orange"
  },
  "settle": {
    "green_max_min": 120
  },
  "rpe": {
    "yellow_if_over": 7
  },
  "standing": {
    "green_ratio": 0.9,
    "orange_ratio": 0.6,
    "regress_level_ratio": 0.5,
    "settle_exit_ratio": 0.7
  },
  "sitting": {
    "green_ratio": 0.9,
    "orange_ratio": 0.6,
    "baseline_min": 20
  },
  "sleep": {
    "block_advance_if_hours_below": 5.5,
    "block_advance_if_quality_at_or_below": 2
  },
  "forced_rest": {
    "yellow_at": 1,
    "orange_at": 3
  },
  "incidents": {
    "accidental_bend_twist": {
      "yellow_if": {
        "settle_max_min": 30,
        "pain_peak_max": 4,
        "leg_symptoms": "none"
      },
      "else": "orange",
      "orange_if_count_in_7_days_at_least": 2
    },
    "ordinary_movement": {
      "first": "orange",
      "red_clinician_if_distinct_days_in_3_days_at_least": 2,
      "red_clinician_if_leg_symptoms": true
    },
    "exercise": {
      "result": "orange"
    },
    "at_rest": {
      "result": "orange",
      "red_clinician_if_pain_peak_at_least": 7
    }
  },
  "leg_symptoms": {
    "severity": {
      "none": "green",
      "buttock": "orange",
      "thigh": "orange",
      "below_knee": "red_clinician",
      "foot": "red_clinician"
    },
    "numbness_tingling_new": "red_clinician",
    "red_clinician_if_consecutive_checkins_at_least": 3
  },
  "hip_shift": {
    "result": "orange",
    "red_clinician_if_consecutive_checkins_at_least": 3
  },
  "night": {
    "unrelieved_night_pain": "red_clinician"
  },
  "red": {
    "emergency": [
      "saddle_numbness",
      "bladder_bowel_change"
    ],
    "clinician": [
      "new_leg_weakness",
      "new_numbness_tingling",
      "fever_with_back_pain",
      "unexplained_weight_loss",
      "night_pain_unrelieved",
      "bilateral_leg_symptoms",
      "trauma_since_last_checkin",
      "new_swelling_in_back"
    ]
  },
  "advance": {
    "clean_exposures_required": 2,
    "clean_exposures_required_when_locked": 3,
    "max_item_changes_per_finalized_session": 3,
    "core_clean_days_required": 3,
    "walk_clean_days_required": 3,
    "one_variable_per_item": true,
    "blocked_by": [
      "poor_sleep",
      "illness",
      "unusual_load",
      "missing_morning_checkin",
      "pause_mode"
    ]
  },
  "hold": {
    "consecutive_yellow_sessions_to_regress_one_step": 3
  },
  "regress": {
    "orange_events_in_7_days_for_easy_dose_lock": 2,
    "orange_events_in_14_days_for_level_regress": 3,
    "orange_in_first_sessions_after_promotion": 2,
    "orange_daily_statuses_in_row_after_step_regress": 3,
    "standing_below_half_baseline_evenings_in_row": 2
  },
  "settle_mode": {
    "exit_green_daily_statuses_in_row": 2,
    "resume_rungs_back": 1,
    "resume_clean_exposures_required": 3
  },
  "layoff": {
    "no_strength_session_days_regress_one_step": 10,
    "no_strength_session_days_regress_level": 21,
    "enabled": true
  },
  "stuck": {
    "recommend_clinician_if_orange_events_in_14_days_at_least": 3,
    "after_level_regress": true
  },
  "missing_data": {
    "session_unevaluated_after_hours": 36,
    "never_advance_on_missing_data": true
  },
  "baseline_updates": {
    "stiffness_min": "median of last 5 green-morning values; may only DECREASE automatically; increases need David's confirmation",
    "standing_h": "median of last 5 uncensored values from green days; may only INCREASE automatically; decreases need David's confirmation",
    "sitting_min": "median of last 5 uncensored first-pressure minutes from green work days; may only INCREASE automatically; decreases need David's confirmation",
    "pain_rest": "median of last 5 green evening pain values, rounded; changes need David's confirmation"
  },
  "gate_tests": {
    "requires_green_yesterday_and_today": true,
    "pass_confirmed_after_green_next_morning": true,
    "retest_after_clean_sessions": 2,
    "max_test_groups_per_session": 1
  },
  "promotion_probation_sessions": 2
}
