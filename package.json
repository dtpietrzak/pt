{
  "name": "pt",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npx --yes serve@14 public -l 5182",
    "sw": "node scripts/gen-sw.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "deploy": "npm run sw && cf deploy ./public",
    "deploy:rules": "npx --yes firebase-tools@latest deploy --only firestore:rules,firestore:indexes",
    "deploy:auth": "npx --yes firebase-tools@latest deploy --only auth",
    "deploy:all": "npm test && npm run deploy:rules && npm run deploy",
    "sync-seed": "scripts/sync-seed.sh",
    "sync-auth-helpers": "scripts/sync-auth-helpers.sh"
  },
  "devDependencies": {
    "cf": "^1.0.0-rc.1"
  },
  "engines": {
    "node": ">=24"
  }
}
